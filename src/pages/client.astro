---
// Client work. Each client gets a private link like /client/#<token>, created
// in the admin (Client work). The page asks the client-portal edge function for
// the files and shows them; the client can approve, ask for changes or leave a
// review, which is saved and then sent to the owner on WhatsApp.
import Icon from '../components/Icon.astro';
import Logo from '../components/Logo.astro';
import Base from '../layouts/Base.astro';
import { t } from '../lib/t';
import { DEFAULTS } from '../lib/texts';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
// Wording for the messages the script below shows (Site text: Client page).
const words = Object.fromEntries(
  Object.keys(DEFAULTS)
    .filter((k) => k.startsWith('client.'))
    .map((k) => [k.slice('client.'.length), t(k)]),
);
const [agreeA, agreeB = '', agreeC = ''] = t('client.agree').split(/\{terms\}|\{privacy\}/);
---
<Base title="Your project" noindex bare>
  <div class="shell" data-words={JSON.stringify(words)}>
    <header class="top">
      <div class="container bar">
        <a href={base} aria-label="Trutech Business home"><Logo /></a>
        <span class="secure"><Icon name="lock" size={16} /> {t('client.private')}</span>
      </div>
    </header>

    <section class="container delivery" data-state="loading" aria-busy="true">
      <p class="sr-only" role="status">Opening your project…</p>
      <div aria-hidden="true">
        <span class="skel skel-line" style="width: 120px"></span>
        <span class="skel skel-title"></span>
        <span class="skel skel-pill"></span>
        <span class="skel skel-line" style="width: 85%; margin-top: 24px"></span>
        <span class="skel skel-line" style="width: 60%"></span>
        <div class="files skel-files">
          {[0, 1, 2].map(() => (
            <div class="file card">
              <span class="skel skel-block"></span>
              <span class="skel skel-line" style="width: 70%"></span>
              <span class="skel skel-line" style="width: 40%"></span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="container state" data-state="error" hidden>
      <h1>{t('client.errorTitle')}</h1>
      <p class="lead" data-error>{t('client.errIncomplete')}</p>
      <a class="btn btn-primary" href={base + 'contact/'}>{t('client.errorButton')}</a>
    </section>

    <div class="container delivery" data-state="ready" hidden>
      <p class="eyebrow" data-field="client"></p>
      <h1 data-field="title"></h1>
      <div class="meta">
        <span class="badge" data-field="status"></span>
        <span class="muted" data-field="date"></span>
      </div>
      <p class="lead message" data-field="message"></p>

      <section class="downloads" data-downloads hidden>
        <h2 class="h2">{t('client.downloadsTitle')}</h2>
        <p class="muted">{t('client.downloadsIntro')}</p>
        <ul class="dl-list" data-download-list></ul>
      </section>

      <h2 class="h2" data-files-title>{t('client.files')}</h2>
      <div class="files" data-files></div>

      <section class="card review" data-review aria-labelledby="review-title">
        <h2 id="review-title" data-review-title>{t('client.feedbackTitle')}</h2>
        <p class="muted" data-review-intro></p>
        <form data-form novalidate>
          <div class="field">
            <label for="r-name">{t('client.name')}</label>
            <input id="r-name" name="name" autocomplete="name" maxlength="120" required />
          </div>
          <fieldset class="field choices" data-decisions>
            <legend>{t('client.decision')}</legend>
            <label class="choice"><input type="radio" name="decision" value="approve" checked /> <span><strong>{t('client.approve')}</strong> {t('client.approveNote')}</span></label>
            <label class="choice"><input type="radio" name="decision" value="changes" /> <span><strong>{t('client.changes')}</strong> {t('client.changesNote')}</span></label>
          </fieldset>
          <fieldset class="field stars" data-rating hidden>
            <legend>{t('client.rating')}</legend>
            <div class="star-row">
              {[5, 4, 3, 2, 1].map((n) => (
                <label class="star">
                  <input type="radio" name="rating" value={n} checked={n === 5} />
                  <span aria-hidden="true">★</span>
                  <span class="sr-only">{n} out of 5</span>
                </label>
              ))}
            </div>
          </fieldset>
          <div class="field">
            <label for="r-comment" data-comment-label>{t('client.comments')}</label>
            <textarea id="r-comment" name="comment" rows="5" maxlength="4000" placeholder={t('client.placeholder')}></textarea>
          </div>
          <p class="error" role="alert" data-form-error hidden></p>
          <button class="btn btn-primary" type="submit" data-submit><Icon name="whatsapp" /> <span>{t('client.send')}</span></button>
          <p class="hint muted">
            {t('client.hint')}
            {agreeA}<a href={base + 'terms/'}>{t('terms.title')}</a>{agreeB}<a href={base + 'privacy/'}>{t('privacy.title')}</a>{agreeC}
          </p>
        </form>
        <div class="thanks" data-thanks hidden>
          <h3>{t('client.thanksTitle')}</h3>
          <p class="muted">{t('client.thanksText')}</p>
          <a class="btn btn-primary" data-wa target="_blank" rel="noopener"><Icon name="whatsapp" /> {t('client.thanksButton')}</a>
        </div>
      </section>

      <section class="history" data-history hidden>
        <h2 class="h2">{t('client.earlier')}</h2>
        <ul data-history-list></ul>
      </section>

      <p class="foot muted">
        {t('client.foot')}
        <a href={base + 'terms/'}>{t('footer.terms')}</a> · <a href={base + 'privacy/'}>{t('footer.privacy')}</a>
      </p>
    </div>
  </div>
</Base>

<script>
  import { CLIENT_PORTAL_URL, SUPABASE_ANON_KEY } from '../lib/content';
  import { esc } from '../lib/render';

  type FileItem = { id: string; name: string; size: number; mime: string; url: string | null; download: string | null };
  type Review = { reviewer_name: string; decision: string; rating: number | null; comment: string; created_at: string };
  type Delivery = {
    client_name: string;
    title: string;
    message: string;
    kind: 'review' | 'delivery';
    status: string;
    allow_download: boolean;
    created_at: string;
    files: FileItem[];
    /** Download links (Google Drive), one per format; only when downloads are allowed. */
    links?: { id: string; format: string; label: string; url: string }[];
    reviews: Review[];
    whatsapp: string;
  };

  // Wording from Site text (see the page above).
  const W: Record<string, string> = JSON.parse(document.querySelector<HTMLElement>('.shell')!.dataset.words ?? '{}');
  const fill = (s: string, vars: Record<string, string>) => s.replace(/\{(\w+)\}/g, (m, n) => vars[n] ?? m);
  const STATUS: Record<string, string> = {
    awaiting_review: W['status.awaiting'],
    changes_requested: W['status.changes'],
    approved: W['status.approved'],
    delivered: W['status.delivered'],
  };
  const $ = <T extends HTMLElement>(sel: string) => document.querySelector<T>(sel)!;
  const show = (state: string) =>
    document.querySelectorAll<HTMLElement>('[data-state]').forEach((el) => (el.hidden = el.dataset.state !== state));
  const fail = (message: string) => {
    $('[data-error]').textContent = message;
    show('error');
  };
  const set = (field: string, value?: string) => {
    const el = $(`[data-field="${field}"]`);
    el.textContent = value ?? '';
    el.hidden = !value;
  };
  const date = (iso: string) => new Date(iso).toLocaleDateString(undefined, { day: 'numeric', month: 'long', year: 'numeric' });
  const size = (n: number) => (n < 1024 * 1024 ? `${Math.max(1, Math.round(n / 1024))} KB` : `${(n / 1024 / 1024).toFixed(1)} MB`);
  const ext = (name: string) => (name.includes('.') ? name.split('.').pop()!.toUpperCase().slice(0, 9) : 'FILE');
  const kindOf = (f: FileItem) =>
    f.mime.startsWith('image/') && !f.mime.includes('photoshop')
      ? 'image'
      : f.mime === 'application/pdf' || f.name.toLowerCase().endsWith('.pdf')
        ? 'pdf'
        : f.mime.startsWith('video/')
          ? 'video'
          : f.mime.startsWith('audio/')
            ? 'audio'
            : 'file';

  const token = location.hash.slice(1);
  const api = (init?: RequestInit, query = '') =>
    fetch(CLIENT_PORTAL_URL + query, { ...init, headers: { apikey: SUPABASE_ANON_KEY, 'Content-Type': 'application/json', ...init?.headers } });

  const DOWNLOAD_ICON =
    '<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v12"/><path d="m7 11 5 5 5-5"/><path d="M5 20h14"/></svg>';

  function downloadLink(l: { format: string; label: string; url: string }) {
    const action = fill(W.downloadAs, { format: l.format });
    return `<li><a class="dl" href="${esc(l.url)}" target="_blank" rel="noopener noreferrer">
      <span class="ext">${esc(l.format)}</span>
      <span class="dl-text"><strong>${esc(l.label || action)}</strong>${l.label ? `<small>${esc(action)}</small>` : ''}</span>
      <span class="dl-icon">${DOWNLOAD_ICON}</span></a></li>`;
  }

  function fileCard(f: FileItem, allowDownload: boolean) {
    const kind = kindOf(f);
    const url = f.url ? esc(f.url) : '';
    if (!allowDownload) return protectedCard(f, kind, url);
    const preview =
      kind === 'image' && url
        ? `<a class="preview" href="${url}" target="_blank" rel="noopener"><img src="${url}" alt="${esc(f.name)}" loading="lazy" /></a>`
        : kind === 'video' && url
          ? `<div class="preview"><video src="${url}" controls preload="metadata"></video></div>`
          : kind === 'audio' && url
            ? `<div class="preview icon">♪<audio src="${url}" controls preload="none"></audio></div>`
            : `<div class="preview icon"><span class="ext">${esc(ext(f.name))}</span></div>`;
    const actions = [
      kind === 'pdf' && url ? `<a class="btn btn-ghost" href="${url}" target="_blank" rel="noopener">${esc(W.viewPdf)}</a>` : '',
      f.download ? `<a class="btn btn-primary" href="${esc(f.download)}">${esc(W.download)}</a>` : '',
    ].join('');
    return `<article class="file card">${preview}<div class="info"><h3 class="name">${esc(f.name)}</h3><p class="muted">${esc(ext(f.name))} · ${size(f.size)}</p><div class="actions">${actions}</div></div></article>`;
  }

  // View-only files (downloads off): shown inside the page with a watermark,
  // without links to the files themselves. Websites can't block screenshots;
  // this makes copies harder to take and marks the ones that are. Images,
  // videos and PDFs also open full screen, with the same protection.
  function protectedCard(f: FileItem, kind: string, url: string) {
    const wm = '<div class="wm" aria-hidden="true"></div>';
    const viewable = ['image', 'video', 'pdf'].includes(kind) && url;
    const preview =
      kind === 'image' && url
        ? `<div class="preview guarded zoomable" data-view role="button" tabindex="0" aria-label="${esc(W.fullScreen)}: ${esc(f.name)}"><canvas data-image="${url}" role="img" aria-label="${esc(f.name)}"></canvas>${wm}</div>`
        : kind === 'video' && url
          ? `<div class="preview guarded"><video src="${url}" controls controlslist="nodownload noplaybackrate noremoteplayback" disablepictureinpicture preload="metadata"></video>${wm}</div>`
          : kind === 'audio' && url
            ? `<div class="preview icon">♪<audio src="${url}" controls controlslist="nodownload noplaybackrate" preload="none"></audio></div>`
            : kind === 'pdf' && url
              ? `<div class="preview guarded pdf"><span class="ext">PDF</span>${wm}</div>`
              : `<div class="preview icon"><span class="ext">${esc(ext(f.name))}</span></div>`;
    const action = viewable
      ? `<button class="btn btn-ghost" type="button" data-view>${esc(kind === 'pdf' ? W.viewPdf : W.fullScreen)}</button>`
      : kind === 'file'
          ? `<p class="note">${esc(W.viewOnlyNote)}</p>`
          : '';
    const data = viewable ? ` data-kind="${kind}" data-url="${url}" data-name="${esc(f.name)}"` : '';
    return `<article class="file card"${data}>${preview}<div class="info"><h3 class="name">${esc(f.name)}</h3><p class="muted">${esc(ext(f.name))} · ${size(f.size)} · ${esc(W.viewOnly)}</p><div class="actions">${action}</div></div></article>`;
  }

  function protect(d: Delivery) {
    const shell = $('.shell');
    shell.classList.add('protected');
    const mark = `${d.client_name} · Trutech Business · ${date(new Date().toISOString())}`;
    const tile = (color: string) =>
      `url("data:image/svg+xml,${encodeURIComponent(
        `<svg xmlns='http://www.w3.org/2000/svg' width='320' height='180'><text x='10' y='110' transform='rotate(-24 160 90)' fill='${color}' font-family='Montserrat,Arial,sans-serif' font-size='15' font-weight='600'>${mark.replace(/[<&'"]/g, '')}</text></svg>`,
      )}")`;
    shell.style.setProperty('--wm', tile('rgba(255,255,255,0.42)'));
    shell.style.setProperty('--wm-dark', tile('rgba(10,25,49,0.32)'));

    // Images are drawn on a canvas with the watermark baked in, so there's no
    // image to save, drag or open on its own.
    const images = new Map<string, Promise<HTMLImageElement>>();
    const load = (url: string) => {
      if (!images.has(url))
        images.set(
          url,
          new Promise((ok, fail) => {
            const img = new Image();
            img.onload = () => ok(img);
            img.onerror = fail;
            img.src = url;
          }),
        );
      return images.get(url)!;
    };
    const drawMarked = (canvas: HTMLCanvasElement, img: HTMLImageElement, maxWidth: number) => {
      const scale = Math.min(1, maxWidth / img.naturalWidth);
      canvas.width = Math.round(img.naturalWidth * scale);
      canvas.height = Math.round(img.naturalHeight * scale);
      const ctx = canvas.getContext('2d')!;
      ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
      ctx.save();
      ctx.font = `600 ${Math.max(14, Math.round(canvas.width / 34))}px Montserrat, Arial, sans-serif`;
      ctx.fillStyle = 'rgba(255,255,255,0.45)';
      ctx.strokeStyle = 'rgba(10,25,49,0.35)';
      ctx.lineWidth = Math.max(1, canvas.width / 1600);
      ctx.translate(canvas.width / 2, canvas.height / 2);
      ctx.rotate(-0.42);
      const step = Math.max(120, canvas.width / 5);
      for (let y = -canvas.height; y < canvas.height; y += step) {
        for (let x = -canvas.width; x < canvas.width; x += ctx.measureText(mark).width + 60) {
          ctx.fillText(mark, x, y);
          ctx.strokeText(mark, x, y);
        }
      }
      ctx.restore();
    };
    document.querySelectorAll<HTMLCanvasElement>('canvas[data-image]').forEach((canvas) => {
      load(canvas.dataset.image!)
        .then((img) => drawMarked(canvas, img, 1600))
        .catch(() => {});
    });

    const files = $('[data-files]');
    files.addEventListener('click', (e) => {
      const card = (e.target as HTMLElement).closest('[data-view]')?.closest<HTMLElement>('.file');
      if (card) openViewer(card.dataset.kind!, card.dataset.url!, card.dataset.name!);
    });
    files.addEventListener('keydown', (e) => {
      const el = e.target as HTMLElement;
      if ((e.key === 'Enter' || e.key === ' ') && el.matches('.zoomable[data-view]')) {
        e.preventDefault();
        el.click();
      }
    });

    // Full-screen view. It stays inside this page, so the watermark, the
    // blur and the blocked right-click, saving and printing all still apply.
    const viewer = document.createElement('div');
    viewer.className = 'viewer';
    viewer.hidden = true;
    viewer.setAttribute('role', 'dialog');
    viewer.setAttribute('aria-modal', 'true');
    viewer.innerHTML = `<div class="v-bar"><p class="v-name" data-v-name></p><div class="v-tools">
        <button type="button" class="v-btn" data-zoom="-1" aria-label="${esc(W.zoomOut)}">−</button>
        <span class="v-level" data-v-level aria-live="polite"></span>
        <button type="button" class="v-btn" data-zoom="1" aria-label="${esc(W.zoomIn)}">+</button>
        <button type="button" class="v-btn v-close" data-v-close>${esc(W.close)} ✕</button></div></div>
      <div class="v-stage" data-v-stage></div>`;
    shell.append(viewer);
    const stage = viewer.querySelector<HTMLElement>('[data-v-stage]')!;
    const levels = [1, 1.5, 2, 3, 4];
    let level = 0;
    let canvas: HTMLCanvasElement | null = null;
    let opener: HTMLElement | null = null;
    // Shows the image at the zoom level, keeping the middle of the view in place.
    const fit = () => {
      if (!canvas?.width) return;
      const cx = (stage.scrollLeft + stage.clientWidth / 2) / (stage.scrollWidth || 1);
      const cy = (stage.scrollTop + stage.clientHeight / 2) / (stage.scrollHeight || 1);
      const base = Math.min(stage.clientWidth / canvas.width, stage.clientHeight / canvas.height);
      canvas.style.width = `${Math.round(canvas.width * base * levels[level])}px`;
      stage.classList.toggle('zoomed', level > 0);
      viewer.querySelector('[data-v-level]')!.textContent = `${Math.round(levels[level] * 100)}%`;
      stage.scrollLeft = cx * stage.scrollWidth - stage.clientWidth / 2;
      stage.scrollTop = cy * stage.scrollHeight - stage.clientHeight / 2;
    };
    const zoom = (by: number) => {
      level = Math.min(levels.length - 1, Math.max(0, level + by));
      fit();
    };
    function openViewer(kind: string, url: string, name: string) {
      opener = document.activeElement as HTMLElement;
      level = 0;
      canvas = null;
      viewer.setAttribute('aria-label', name);
      viewer.querySelector('[data-v-name]')!.textContent = name;
      viewer.classList.toggle('can-zoom', kind === 'image');
      const wm = '<div class="wm" aria-hidden="true"></div>';
      if (kind === 'image') {
        stage.innerHTML = `<canvas role="img" aria-label="${esc(name)}"></canvas>`;
        canvas = stage.querySelector('canvas')!;
        const c = canvas;
        load(url)
          .then((img) => {
            if (c !== canvas) return;
            drawMarked(c, img, 2400);
            fit();
          })
          .catch(() => {});
      } else if (kind === 'video') {
        stage.innerHTML = `<div class="v-media"><video src="${esc(url)}" controls autoplay playsinline controlslist="nodownload noplaybackrate noremoteplayback nofullscreen" disablepictureinpicture></video>${wm}</div>`;
      } else {
        // PDFs show without the viewer's download and print toolbar.
        stage.innerHTML = `<div class="v-media v-pdf"><iframe src="${esc(url)}#toolbar=0&navpanes=0&statusbar=0&view=FitH" title="${esc(name)}"></iframe>${wm}</div>`;
      }
      viewer.hidden = false;
      document.documentElement.classList.add('viewing');
      viewer.requestFullscreen?.().catch(() => {});
      viewer.querySelector<HTMLButtonElement>('[data-v-close]')!.focus();
    }
    function closeViewer() {
      if (viewer.hidden) return;
      viewer.hidden = true;
      stage.innerHTML = '';
      canvas = null;
      document.documentElement.classList.remove('viewing');
      if (document.fullscreenElement) document.exitFullscreen().catch(() => {});
      opener?.focus();
    }
    viewer.addEventListener('click', (e) => {
      const el = e.target as HTMLElement;
      if (el.closest('[data-v-close]')) closeViewer();
      const z = el.closest<HTMLElement>('[data-zoom]');
      if (z) zoom(Number(z.dataset.zoom));
    });
    // Double-click or double-tap zooms in; again at the closest level, back out.
    stage.addEventListener('dblclick', () => {
      if (!canvas) return;
      level = level < levels.length - 1 ? level + 1 : 0;
      fit();
    });
    // Drag to move around a zoomed image.
    stage.addEventListener('pointerdown', (e) => {
      if (!canvas || level === 0 || e.pointerType === 'touch') return;
      let last = { x: e.clientX, y: e.clientY };
      stage.setPointerCapture(e.pointerId);
      const move = (ev: PointerEvent) => {
        stage.scrollLeft -= ev.clientX - last.x;
        stage.scrollTop -= ev.clientY - last.y;
        last = { x: ev.clientX, y: ev.clientY };
      };
      const end = () => stage.removeEventListener('pointermove', move);
      stage.addEventListener('pointermove', move);
      stage.addEventListener('pointerup', end, { once: true });
      stage.addEventListener('pointercancel', end, { once: true });
    });
    addEventListener('resize', fit);
    addEventListener('keydown', (e) => {
      if (viewer.hidden) return;
      if (e.key === 'Escape') closeViewer();
      if (e.key === '+' || e.key === '=') zoom(1);
      if (e.key === '-') zoom(-1);
    });

    [files, viewer].forEach((el) =>
      ['contextmenu', 'dragstart', 'copy'].forEach((type) => el.addEventListener(type, (e) => e.preventDefault())),
    );
    // Blur the files whenever the page isn't in front: switching apps, opening
    // a screenshot or recording tool, or pressing Print Screen.
    const shield = (on: boolean) => shell.classList.toggle('shielded', on);
    addEventListener('blur', () => {
      if (!(document.activeElement instanceof HTMLIFrameElement)) shield(true);
    });
    addEventListener('focus', () => shield(false));
    document.addEventListener('visibilitychange', () => shield(document.hidden));
    addEventListener('keyup', (e) => {
      if (e.key !== 'PrintScreen') return;
      shield(true);
      navigator.clipboard?.writeText('').catch(() => {});
      setTimeout(() => shield(false), 1500);
    });
    addEventListener('keydown', (e) => {
      if ((e.ctrlKey || e.metaKey) && ['s', 'p'].includes(e.key.toLowerCase())) e.preventDefault();
    });
  }

  function history(reviews: Review[]) {
    const label = (r: Review) =>
      r.decision === 'approve' ? W['status.approved'] : r.decision === 'changes' ? W['status.changes'] : W.earlier;
    $('[data-history-list]').innerHTML = reviews
      .slice()
      .reverse()
      .map(
        (r) =>
          `<li><p class="muted">${esc(date(r.created_at))} · ${esc(r.reviewer_name || 'Client')} · ${label(r)}${r.rating ? ` · ${'★'.repeat(r.rating)}` : ''}</p>${r.comment ? `<p>${esc(r.comment)}</p>` : ''}</li>`,
      )
      .join('');
    $('[data-history]').hidden = reviews.length === 0;
  }

  function whatsappText(d: Delivery, name: string, decision: string, rating: number | null, comment: string) {
    const verdict =
      decision === 'approve'
        ? d.kind === 'delivery'
          ? W.waReceived
          : W.waApprove
        : decision === 'changes'
          ? W.waChanges
          : '';
    return [
      fill(W.waHello, { name: name || d.client_name }),
      fill(W.waProject, { project: d.title }),
      verdict,
      rating ? `Rating: ${'★'.repeat(rating)} (${rating}/5)` : '',
      comment ? `\n${comment}` : '',
      `\n${location.href}`,
    ]
      .filter(Boolean)
      .join('\n');
  }

  function setupForm(d: Delivery) {
    const form = $<HTMLFormElement>('[data-form]');
    const isDelivery = d.kind === 'delivery';
    $('[data-review-title]').textContent = isDelivery ? W.reviewTitle : W.feedbackTitle;
    $('[data-review-intro]').textContent = isDelivery ? W.reviewIntro : W.feedbackIntro;
    $('[data-decisions]').hidden = isDelivery;
    $('[data-rating]').hidden = !isDelivery;
    $('[data-comment-label]').textContent = isDelivery ? W.reviewComments : W.comments;
    (form.elements.namedItem('name') as HTMLInputElement).value = d.client_name;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const name = String(data.get('name') ?? '').trim();
      const decision = isDelivery ? 'approve' : String(data.get('decision'));
      const rating = isDelivery ? Number(data.get('rating')) || null : null;
      const comment = String(data.get('comment') ?? '').trim();
      const error = $('[data-form-error]');
      error.hidden = true;
      if (!name) return Object.assign(error, { hidden: false, textContent: W.errName });
      if (decision === 'changes' && !comment)
        return Object.assign(error, { hidden: false, textContent: W.errChanges });

      const submit = $<HTMLButtonElement>('[data-submit]');
      submit.disabled = true;
      submit.querySelector('span')!.textContent = W.sending;
      try {
        const res = await api({ method: 'POST', body: JSON.stringify({ t: token, name, decision, rating, comment }) });
        if (!res.ok) throw new Error(String(res.status));
        const { whatsapp } = await res.json();
        const wa = `https://wa.me/${whatsapp || d.whatsapp}?text=${encodeURIComponent(whatsappText(d, name, decision, rating, comment))}`;
        $<HTMLAnchorElement>('[data-wa]').href = wa;
        form.hidden = true;
        $('[data-thanks]').hidden = false;
        history([...d.reviews, { reviewer_name: name, decision, rating, comment, created_at: new Date().toISOString() }]);
        location.href = wa;
      } catch {
        submit.disabled = false;
        submit.querySelector('span')!.textContent = W.send;
        Object.assign(error, { hidden: false, textContent: W.errSend });
      }
    });
  }

  async function main() {
    if (!/^[A-Za-z0-9_-]{16,64}$/.test(token)) return fail(W.errIncomplete);
    let d: Delivery;
    try {
      const res = await api(undefined, `?t=${encodeURIComponent(token)}`);
      if (res.status === 404) return fail(W.errInactive);
      if (!res.ok) throw new Error(String(res.status));
      d = await res.json();
    } catch {
      return fail(W.errNetwork);
    }
    set('client', d.client_name);
    set('title', d.title);
    set('status', STATUS[d.status] ?? '');
    set('date', date(d.created_at));
    set('message', d.message);
    document.title = `${d.title} · Trutech Business`;
    const links = d.links ?? [];
    $('[data-downloads]').hidden = !links.length;
    $('[data-download-list]').innerHTML = links.map(downloadLink).join('');
    // With download links and nothing uploaded, there's no empty Files list.
    $('[data-files-title]').hidden = !d.files.length && links.length > 0;
    $('[data-files]').innerHTML = d.files.length
      ? d.files.map((f) => fileCard(f, d.allow_download)).join('')
      : links.length
        ? ''
        : `<p class="muted">${esc(W.noFiles)}</p>`;
    if (!d.allow_download) protect(d);
    history(d.reviews);
    setupForm(d);
    show('ready');
  }

  main();
  // A different link pasted into the same tab only changes the #part.
  addEventListener('hashchange', () => location.reload());
</script>

