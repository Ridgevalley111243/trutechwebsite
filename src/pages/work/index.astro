---
import PageHero from '../../components/PageHero.astro';
import Base from '../../layouts/Base.astro';
import { projects } from '../../lib/build-data';
import { fingerprint, groupOf } from '../../lib/content';
import { filtersHTML, workGridHTML } from '../../lib/render';
import { coverImages } from '../../lib/images';
import { t } from '../../lib/t';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const groups = [...new Set(projects.map(groupOf))];
const covers = await coverImages(projects, '(min-width: 1000px) 31vw, (min-width: 700px) 46vw, 92vw');
---
<Base title={t('nav.work')} description={t('workPage.lead')}>
  <PageHero eyebrow="workPage.eyebrow" title="workPage.title" lead="workPage.lead" />
  <section class="section">
    <div class="container">
      <h2 class="sr-only">Projects</h2>
      <div class="filters" role="group" aria-label="Filter projects" data-filters data-all={t('workPage.all')} set:html={filtersHTML(groups, t('workPage.all'))} />
      <div class="grid grid-3" data-grid data-fp={fingerprint(projects)} set:html={workGridHTML(projects, base, groupOf, covers)} />
    </div>
  </section>
</Base>
<script>
  import { bindFilters, liveWork } from '../../scripts/live';
  const grid = document.querySelector<HTMLElement>('[data-grid]')!;
  const filters = document.querySelector<HTMLElement>('[data-filters]')!;
  bindFilters(grid, filters);
  liveWork(grid, filters).catch(() => {});
</script>
<style>
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 40px;
  }
  .filters :global(button) {
    min-height: 44px;
    padding: 0 18px;
    border-radius: 999px;
    border: 1.5px solid var(--border);
    background: var(--surface);
    color: var(--text);
    font: 600 0.9rem var(--font-body);
    cursor: pointer;
    transition:
      background-color 0.2s,
      border-color 0.2s,
      color 0.2s;
  }
  .filters :global(button:hover) {
    border-color: var(--gold-500);
  }
  .filters :global(button[aria-pressed='true']) {
    background: var(--inverse-bg);
    border-color: var(--inverse-bg);
    color: var(--inverse-text);
  }
</style>
