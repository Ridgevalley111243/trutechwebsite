---
// Leaf mark in a round badge + "Trutech." wordmark set in Sora.
interface Props {
  /** Below the fold (footer): load the mark lazily. */
  lazy?: boolean;
}
const { lazy = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<span class="logo">
  <span class="mark"><img src={`${base}brand/leaf-mark.png`} alt="" width="24" height="18" loading={lazy ? 'lazy' : undefined} /></span>
  <span class="word">Trutech<span class="dot">.</span></span>
</span>
<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }
  .mark {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 999px;
    background: #242424;
    flex: none;
  }
  img {
    width: 24px;
    height: auto;
  }
  .word {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.2rem;
    letter-spacing: -0.02em;
    color: var(--text);
  }
  .dot {
    color: var(--amber);
  }
</style>
