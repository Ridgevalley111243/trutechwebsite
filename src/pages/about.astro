---
import Icon from '../components/Icon.astro';
import PageHero from '../components/PageHero.astro';
import Text from '../components/Text.astro';
import Base from '../layouts/Base.astro';
import { CENTRED, photoPosStyle } from '../lib/content';
import { imgAttrs, responsive } from '../lib/images';
import { t } from '../lib/t';
import { site } from '../site';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const logo = `${base}brand/logo-on-dark.png`;
const photo = site.aboutPhoto || site.photo;
const pos = photoPosStyle(site.aboutPhoto ? site.aboutPhotoPos : CENTRED);
const img = await responsive(photo, [480, 800, 1200], '(min-width: 900px) 40vw, 92vw');
const photoAlt = `Photo of ${site.owner || 'the founder of Trutech Business'}`;
---
<Base title={t('about.eyebrow')} description={site.about.paragraphs[0]}>
  <PageHero eyebrow="about.eyebrow" title="about.title" lead="about.lead" />
  <section class="section">
    <div class="container story">
      <div class:list={['portrait placed reveal', { 'has-photo': photo }]} data-photo-slot="about" data-photo={photo} data-fallback={logo} style={pos}>
        <img {...(photo ? imgAttrs(img) : { src: logo })} alt={photo ? photoAlt : ''} fetchpriority="high" />
      </div>
      <div class="reveal">
        <Text as="div" class="text" k="about.story" />
        <p class="quote display">“<Text k="brand.tagline" />”</p>
      </div>
    </div>
  </section>

  <section class="section tint">
    <div class="container">
      <div class="section-head reveal">
        <div>
          <Text as="p" class="eyebrow" k="about.rolesLabel" />
          <Text as="h2" k="about.rolesTitle" />
        </div>
      </div>
      <div class="grid grid-3">
        {
          site.about.roles.map((_, i) => (
            <article class="card reveal">
              <Text as="h3" k={`role.${i + 1}.title`} />
              <Text as="p" class="muted" k={`role.${i + 1}.text`} />
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head reveal">
        <div>
          <Text as="p" class="eyebrow" k="about.toolkitLabel" />
          <Text as="h2" k="about.toolkitTitle" />
          <Text as="p" class="muted" k="about.toolkitNote" />
        </div>
      </div>
      <div class="grid grid-3">
        {
          site.about.toolkit.map((tool, i) => (
            <div class="card reveal">
              <Text as="h3" class="area" k={`tool.${i + 1}.area`} />
              <ul class="tags">{tool.tools.map((x) => <li class="tag">{x}</li>)}</ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section mindset">
    <div class="container narrow reveal">
      <Text as="p" class="eyebrow" k="about.mindLabel" />
      <Text as="h2" k="about.mindTitle" />
      <Text as="p" class="lead" k="about.mindText" />
      <a class="btn btn-primary" href={base + 'contact/'}><Text k="about.mindButton" /> <Icon name="arrow" /></a>
    </div>
  </section>
</Base>
<script>
  import { liveProfilePhoto } from '../scripts/profile';
  liveProfilePhoto().catch(() => {});
</script>
<style>
  .story {
    display: grid;
    gap: 48px;
    align-items: center;
  }
  @media (min-width: 900px) {
    .story {
      grid-template-columns: 0.9fr 1.3fr;
      gap: 80px;
    }
  }
  .portrait {
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-lg);
    display: grid;
    place-items: center;
    background: var(--surface-2);
    box-shadow: 12px 12px 0 var(--amber);
    overflow: hidden;
  }
  /* With a photo, it fills the rectangle (.placed in global.css). */
  .portrait:not(.has-photo) img {
    width: 62%;
  }
  .text {
    font-size: 1.08rem;
  }
  .text :global(p) {
    margin: 0 0 1em;
  }
  .quote {
    font-size: clamp(1.7rem, 3vw, 2.4rem);
    color: var(--accent);
    margin-top: 32px;
  }
  .area {
    font-size: 1.4rem;
    margin-bottom: 16px;
  }
  .mindset {
    background: var(--surface-2);
  }
  .narrow {
    max-width: 820px;
  }
  .narrow .lead {
    margin-bottom: 32px;
  }
</style>
