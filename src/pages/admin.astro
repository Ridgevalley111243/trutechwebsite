---
// Admin for the Trutech Business website. Not linked anywhere: open it by
// long-pressing (phone) or double-clicking (computer) an empty part of any
// page, or go to /admin/. Sign-in and data are Supabase (tables site_*).
import Logo from '../components/Logo.astro';
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<Base title="Admin" noindex bare>
  <div class="adm">
    <section class="gate" data-view="loading">
      <div class="spinner" aria-hidden="true"></div>
      <p role="status">Loading…</p>
    </section>

    <section class="gate" data-view="login" hidden>
      <form class="card gate-card" data-login autocomplete="off">
        <Logo />
        <h1>Admin sign in</h1>
        <div class="field">
          <label for="l-email">Email</label>
          <input id="l-email" name="email" type="email" autocomplete="off" autocapitalize="none" spellcheck="false" required readonly data-unlock />
        </div>
        <div class="field">
          <label for="l-password">Password</label>
          <input id="l-password" name="password" type="password" autocomplete="off" required readonly data-unlock />
        </div>
        <p class="error" role="alert" data-login-error hidden></p>
        <button class="btn btn-primary" type="submit">Sign in</button>
        <a class="muted back" href={base}>← Back to the website</a>
      </form>
    </section>

    <section class="gate" data-view="password" hidden>
      <form class="card gate-card" data-new-password novalidate>
        <Logo />
        <h1>Choose your password</h1>
        <p class="muted">You signed in with a temporary password. Choose your own to continue: at least 10 characters.</p>
        <div class="field">
          <label for="p-new">New password</label>
          <input id="p-new" name="password" type="password" autocomplete="new-password" minlength="10" required />
        </div>
        <div class="field">
          <label for="p-confirm">Confirm password</label>
          <input id="p-confirm" name="confirm" type="password" autocomplete="new-password" minlength="10" required />
        </div>
        <p class="error" role="alert" data-password-error hidden></p>
        <button class="btn btn-primary" type="submit">Save password</button>
      </form>
    </section>

    <div data-view="app" hidden>
      <header class="adm-top">
        <div class="container adm-bar">
          <a href="#/projects" class="adm-brand" aria-label="Admin home"><Logo /><span>Admin</span></a>
          <a class="adm-site" href={base} target="_blank" rel="noopener">View site ↗</a>
        </div>
        <nav class="container adm-nav" aria-label="Admin">
          <a href="#/projects" data-nav="projects">Portfolio</a>
          <a href="#/clients" data-nav="clients">Client work</a>
          <a href="#/texts" data-nav="texts">Site text</a>
          <a href="#/settings" data-nav="settings">Settings</a>
          <a href="#/account" data-nav="account">Account</a>
        </nav>
      </header>
      <div class="container adm-main" data-main></div>
    </div>

    <div class="toast" role="status" aria-live="polite" data-toast hidden></div>
  </div>
</Base>

<script>
  import { initAdmin } from '../scripts/admin';
  initAdmin();
</script>

<style>
  /* The admin is always black, whatever the site's light/dark setting. */
  .adm {
    --bg: #000;
    --surface: #0e0e0e;
    --surface-2: #000;
    --text: #f2f2f2;
    --text-muted: #a8a8a8; /* 8.9:1 on black */
    --border: #2a2a2a;
    --accent: var(--gold-300);
    --accent-strong: var(--gold-300);
    --ring: var(--gold-300);
    --field-bg: #000;
    --inverse-bg: #fff;
    --inverse-bg-hover: #dcdcdc;
    --inverse-text-hover: #000;
    --inverse-text: #000;
    --shadow: none;
    --shadow-lg: 0 0 0 1px #2a2a2a;
    --skel: #161616;
    --skel-hi: rgb(255 255 255 / 0.06);
    color-scheme: dark;
    min-height: 100svh;
    background: #000;
    color: var(--text);
  }
  :global(body:has(.adm)) {
    background: #000;
  }
  .gate {
    display: grid;
    place-items: center;
    min-height: 100svh;
    padding: 24px 16px;
    text-align: center;
  }
  .gate-card {
    display: grid;
    gap: 18px;
    width: min(100%, 420px);
    text-align: left;
    box-shadow: var(--shadow-lg);
  }
  .gate-card h1 {
    font-size: 2rem;
    margin: 8px 0 0;
  }
  .gate-card p {
    margin: 0;
  }
  .back {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 0.9rem;
    text-decoration: none;
  }
  .spinner {
    width: 36px;
    height: 36px;
    margin: 0 auto 14px;
    border-radius: 50%;
    border: 3px solid var(--border);
    border-top-color: var(--gold-500);
    animation: spin 0.9s linear infinite;
  }
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
  .adm-top {
    position: sticky;
    top: 0;
    z-index: 20;
    background: #000;
    color: #fff;
    border-bottom: 1px solid #222;
  }
  .adm-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 64px;
  }
  .adm-brand {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    gap: 12px;
    text-decoration: none;
  }
  .adm-brand > span {
    padding: 3px 10px;
    border-radius: 999px;
    background: rgb(255 221 0 / 0.16);
    color: var(--gold-300);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .adm-site {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--gold-300);
    text-decoration: none;
  }
  .adm-nav {
    display: flex;
    gap: 4px;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .adm-nav a {
    flex: 1 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 46px;
    padding: 0 8px;
    white-space: nowrap;
    border-bottom: 3px solid transparent;
    color: #b5b5b5;
    font-weight: 600;
    font-size: 0.93rem;
    text-decoration: none;
  }
  @media (max-width: 420px) {
    .adm-nav a {
      font-size: 0.82rem;
      padding: 0 4px;
    }
  }
  @media (min-width: 720px) {
    .adm-nav a {
      flex: none;
      padding: 0 12px;
    }
  }
  .adm-nav a[aria-current='page'] {
    color: var(--white);
    border-bottom-color: var(--gold-300);
  }
  .adm-main {
    padding-block: 28px 80px;
  }
  .toast {
    position: fixed;
    left: 50%;
    bottom: 24px;
    z-index: 50;
    transform: translateX(-50%);
    max-width: calc(100% - 32px);
    padding: 12px 18px;
    border-radius: 12px;
    background: #fff;
    color: #000;
    font-weight: 500;
  }
  .toast.bad {
    background: #8a1c1c;
    color: #fff;
  }
</style>

<style is:global>
  /* Admin views are drawn by src/scripts/admin.ts. */
  .adm .field {
    display: grid;
    gap: 7px;
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }
  .adm label,
  .adm legend {
    font-weight: 600;
    font-size: 0.9rem;
  }
  .adm input:not([type='checkbox'], [type='radio'], [type='file']),
  .adm select,
  .adm textarea {
    width: 100%;
    min-height: 46px;
    padding: 10px 13px;
    border: 1.5px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--field-bg);
    color: var(--text);
    font: 1rem var(--font-body);
  }
  .adm textarea {
    resize: vertical;
    line-height: 1.55;
  }
  .adm textarea.grow {
    resize: none;
    overflow: hidden;
    line-height: 1.45;
    field-sizing: content;
  }
  /* Site text: several lines, growing with the text (Enter makes a new line). */
  .adm textarea.autosize {
    resize: vertical;
    overflow: hidden;
    line-height: 1.55;
    field-sizing: content;
  }
  .adm textarea.long {
    font-size: 0.95rem;
  }
  .adm .tx-search {
    margin-bottom: 18px;
  }
  .adm .tx-group > summary {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 4px 16px;
    min-height: 44px;
    cursor: pointer;
    list-style: none;
  }
  .adm .tx-group > summary::-webkit-details-marker {
    display: none;
  }
  .adm .tx-group > summary h2 {
    margin: 0;
    font-size: 1.2rem;
    letter-spacing: -0.01em;
  }
  .adm .tx-group > summary h2::before {
    content: '+ ';
    color: var(--accent);
  }
  .adm .tx-group[open] > summary h2::before {
    content: '− ';
  }
  .adm .tx-group[open] > summary {
    margin-bottom: 8px;
  }
  .adm .tx-field {
    padding-top: 14px;
    border-top: 1px solid var(--border);
  }
  .adm .tx-label {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 6px 12px;
  }
  .adm input:focus,
  .adm select:focus,
  .adm textarea:focus {
    border-color: var(--accent);
  }
  .adm .hint,
  .adm .panel p,
  .adm code {
    overflow-wrap: anywhere;
  }
  .adm .hint {
    margin: 0;
    font-size: 0.84rem;
    color: var(--text-muted);
  }
  .adm .error {
    margin: 0;
    padding: 11px 14px;
    border-radius: var(--radius-sm);
    background: #2a0e0e;
    color: #ffb4b4;
  }
  .adm .check {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    font-weight: 500;
  }
  .adm .check input {
    flex: none;
    width: 20px;
    height: 20px;
    accent-color: var(--gold-300);
  }
  .adm .btn {
    min-height: 44px;
    padding: 0 18px;
  }
  .adm .btn-danger {
    border-color: #ff6b5e;
    color: #ff8a80;
    background: transparent;
  }
  .adm .btn-danger:hover {
    background: #2a0e0e;
  }
  .adm .btn-sm {
    min-height: 44px;
    padding: 0 12px;
    font-size: 0.85rem;
  }
  .adm .head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    margin-bottom: 22px;
  }
  .adm .head h1 {
    font-size: clamp(1.8rem, 4vw, 2.4rem);
    margin: 0;
  }
  .adm .crumb {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-bottom: 8px;
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--accent);
    text-decoration: none;
  }
  .adm .panel {
    display: grid;
    gap: 18px;
    margin-bottom: 18px;
  }
  .adm .panel > h2 {
    font-family: var(--font-body);
    font-size: 1.05rem;
    font-weight: 700;
    margin: 0;
  }
  .adm .two {
    display: grid;
    gap: 18px;
  }
  @media (min-width: 720px) {
    .adm .two {
      grid-template-columns: 1fr 1fr;
    }
  }
  .adm .list {
    display: grid;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .adm .row {
    display: grid;
    grid-template-columns: 64px 1fr auto;
    align-items: center;
    gap: 14px;
    padding: 12px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    color: inherit;
    text-decoration: none;
  }
  .adm .row:hover {
    border-color: var(--accent);
  }
  .adm .row.no-thumb {
    grid-template-columns: 1fr auto;
  }
  @media (max-width: 560px) {
    .adm .row {
      grid-template-columns: 64px 1fr;
    }
    .adm .row.no-thumb {
      grid-template-columns: 1fr;
    }
    .adm .row .pills {
      grid-column: -2 / -1;
      justify-content: flex-start;
    }
  }
  .adm .thumb {
    width: 64px;
    height: 48px;
    border-radius: 8px;
    object-fit: cover;
    background: linear-gradient(135deg, #1c1c1c, #333);
  }
  .adm .row strong {
    display: block;
    overflow-wrap: anywhere;
  }
  .adm .row small {
    color: var(--text-muted);
  }
  .adm .pills {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 6px;
  }
  .adm .pill {
    padding: 3px 9px;
    border-radius: 999px;
    background: rgb(255 221 0 / 0.12);
    color: var(--accent-strong);
    font-size: 0.75rem;
    font-weight: 600;
    white-space: nowrap;
  }
  .adm .pill.warn {
    background: #3a2a00;
    color: #ffd27a;
  }
  .adm .pill.good {
    background: #0d2e1e;
    color: #7fe0ad;
  }
  .adm .pill.muted {
    background: var(--surface-2);
    color: var(--text-muted);
  }
  .adm .empty {
    padding: 36px 20px;
    border: 1.5px dashed var(--border);
    border-radius: var(--radius);
    text-align: center;
    color: var(--text-muted);
  }
  .adm .images {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 12px;
  }
  .adm .img-item {
    display: grid;
    gap: 8px;
    padding: 8px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--surface);
  }
  .adm .img-item img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 6px;
    background: var(--surface-2);
  }
  .adm .img-item .tools {
    display: flex;
    gap: 4px;
  }
  .adm .img-item .tools button {
    flex: 1;
    min-height: 44px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--surface-2);
    color: var(--text);
    cursor: pointer;
  }
  .adm .cover-box {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px;
  }
  .adm .cover-box img {
    width: 160px;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 10px;
  }
  .adm .upload {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 16px;
    border: 1.5px dashed var(--accent);
    border-radius: var(--radius-sm);
    color: var(--accent);
    font-weight: 600;
    cursor: pointer;
  }
  .adm .upload input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
  }
  .adm .upload:focus-within {
    outline: 3px solid var(--ring);
    outline-offset: 2px;
  }
  .adm .progress {
    display: grid;
    gap: 6px;
    font-size: 0.88rem;
  }
  .adm .progress progress {
    width: 100%;
    height: 8px;
    accent-color: var(--gold-300);
  }
  .adm .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: center;
  }
  .adm .sticky-actions {
    position: sticky;
    bottom: 0;
    z-index: 5;
    margin-inline: calc(-1 * var(--gutter));
    padding: 12px var(--gutter);
    background: color-mix(in srgb, var(--surface-2) 92%, transparent);
    backdrop-filter: blur(8px);
    border-top: 1px solid var(--border);
  }
  .adm .linkbox {
    display: grid;
    gap: 10px;
    padding: 14px;
    border-radius: var(--radius-sm);
    background: var(--surface-2);
  }
  .adm .linkbox code {
    font-size: 0.85rem;
    overflow-wrap: anywhere;
  }
  .adm .reviews {
    display: grid;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .adm .reviews li {
    padding: 12px 14px;
    border-left: 3px solid var(--gold-500);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    background: var(--surface-2);
    white-space: pre-line;
  }
  .adm .reviews li.changes {
    border-left-color: #c77700;
  }
  .adm .reviews li.approve {
    border-left-color: #1f8a5b;
  }
  .adm .reviews p {
    margin: 0 0 4px;
  }
  .adm .file-row {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 12px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--surface);
  }
  .adm .file-row .ext {
    flex: none;
    display: grid;
    place-items: center;
    min-width: 52px;
    max-width: 96px;
    height: 40px;
    padding: 0 6px;
    border-radius: 8px;
    background: #1c1c1c;
    color: var(--gold-300);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
  }
  .adm .file-row {
    flex-wrap: wrap;
  }
  .adm .file-row small a {
    color: inherit;
    overflow-wrap: anywhere;
  }
  .adm .add-link {
    display: grid;
    gap: 4px;
    margin-top: 18px;
    padding-top: 18px;
    border-top: 1px solid var(--border);
  }
  .adm .note-warn {
    margin: 0 0 14px;
    padding: 10px 14px;
    border: 1px solid var(--amber, #ffa00b);
    border-radius: var(--radius-sm);
    font-size: 0.9rem;
  }
  .adm .file-row div {
    flex: 1 1 160px;
    min-width: 0;
  }
  .adm .file-row strong {
    display: block;
    overflow-wrap: anywhere;
    font-size: 0.95rem;
  }
  .adm .profile {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 18px;
  }
  .adm .profile img,
  .adm .avatar-empty {
    width: 112px;
    height: 112px;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid var(--border);
  }
  .adm .placer {
    margin-top: 24px;
    padding-top: 20px;
    border-top: 1px solid var(--border);
  }
  .adm .placer h3 {
    font-size: 1.05rem;
    margin: 0 0 4px;
  }
  .adm .placer-row {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
    align-items: flex-start;
    margin-top: 14px;
  }
  /* Same shape as the About card on the home page. */
  .adm .placer-frame {
    width: 220px;
    aspect-ratio: 8 / 9;
    border-radius: 18px;
    overflow: hidden;
    background: var(--amber, #ffa00b);
    cursor: grab;
    touch-action: none;
  }
  .adm .placer-frame:active {
    cursor: grabbing;
  }
  .adm .placer-frame img {
    display: block;
    user-select: none;
    pointer-events: none;
  }
  .adm .placer-controls {
    flex: 1 1 220px;
    display: grid;
    gap: 6px;
  }
  .adm .placer-controls input[type='range'] {
    width: 100%;
    accent-color: var(--amber, #ffa00b);
  }
  .adm .avatar-empty {
    display: grid;
    place-items: center;
    background: var(--surface);
    color: var(--text-muted);
    font-size: 0.8rem;
  }
  .adm .socials {
    display: grid;
    gap: 12px;
  }
  .adm .social {
    display: grid;
    gap: 10px;
    padding: 12px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--surface);
  }
  @media (min-width: 900px) {
    .adm .social {
      grid-template-columns: 1fr 1fr 1.6fr 1fr auto;
      align-items: end;
    }
  }
</style>
