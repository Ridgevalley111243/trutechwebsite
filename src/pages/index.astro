---
import Icon from '../components/Icon.astro';
import Text from '../components/Text.astro';
import Base from '../layouts/Base.astro';
import { projects } from '../lib/build-data';
import { CENTRED, featuredOf, fingerprint, photoPosStyle } from '../lib/content';
import { coverImages, imgAttrs, responsive } from '../lib/images';
import { cardHTML } from '../lib/render';
import { tl } from '../lib/t';
import { site, whatsappLink } from '../site';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const featured = featuredOf(projects);
const leaf = `${base}brand/leaf-light.png`;
const aboutPhoto = site.aboutPhoto || site.photo;
const aboutPos = photoPosStyle(site.aboutPhoto ? site.aboutPhotoPos : CENTRED);
// Smaller copies for the screen size (the original stays in data-photo).
const heroImg = await responsive(site.photo, [360, 540, 720, 1000], '(min-width: 1000px) 500px, min(92vw, 500px)');
const aboutImg = await responsive(aboutPhoto, [480, 800, 1200], '(min-width: 900px) 460px, 92vw');
const covers = await coverImages(featured, '(min-width: 700px) 46vw, 92vw');
const photoAlt = `Photo of ${site.owner || 'the founder of Trutech Business'}`;
const follow = [
  ...site.socials.map((s) => ({ href: s.url, label: `${s.label}: ${s.handle}`, icon: s.icon })),
  ...(whatsappLink() ? [{ href: whatsappLink(), label: 'WhatsApp', icon: 'whatsapp' }] : []),
  ...(site.email ? [{ href: `mailto:${site.email}`, label: `Email: ${site.email}`, icon: 'mail' }] : []),
];
// A skill written as *Skill* in Site text is filled in amber.
const skills = tl('home.skills').map((s) => ({ label: s.replace(/^\*(.*)\*$/, '$1'), on: /^\*.*\*$/.test(s) }));
const chips = tl('home.about.chips');
---
<Base>
  {/* Hero */}
  <section class="hero">
    <div class="container hero-inner">
      <p class="badge" data-intro="line"><span class="badge-dot" aria-hidden="true"></span><Text k="home.badge" /></p>
      <Text as="h1" k="home.title" data-intro="line" />
      <Text as="p" class="sub" k="home.sub" data-intro="line" />

      <div class="stage-row">
        <div class="side left" data-intro="left">
          {
            follow.length > 0 && (
              <div class="follow">
                <Text as="p" class="muted" k="home.follow" />
                <ul class="socials">
                  {follow.map((f) => (
                    <li>
                      <a href={f.href} aria-label={f.label} target={f.href.startsWith('http') ? '_blank' : undefined} rel="noopener">
                        <Icon name={f.icon} size={18} />
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )
          }
          <div class="proof">
            <Text as="p" class="proof-title" k="home.proofTitle" />
            <Text as="p" class="muted" k="home.proofText" />
          </div>
        </div>

        <div class="stage">
          <span class="watermark" aria-hidden="true">TRUTECH</span>
          <span class="glow" aria-hidden="true" data-intro="photo"></span>
          <div class:list={['arch', { 'has-photo': site.photo }]} data-photo-slot data-photo={site.photo} data-fallback={leaf}>
            <span class="lift"><img {...(site.photo ? imgAttrs(heroImg) : { src: leaf })} alt={site.photo ? photoAlt : ''} width="380" height="500" fetchpriority="high" /></span>
          </div>
          <script is:inline>
            // Shows the photo as soon as the early settings request (Base.astro)
            // confirms it's still the current one, without waiting for the
            // page's scripts. Anything else is left to src/scripts/profile.ts.
            (function () {
              var slot = document.currentScript.previousElementSibling;
              if (!window.__settings) return;
              window.__settings.then(function (rows) {
                var d = (rows && rows[0] && rows[0].data) || null;
                if (d && (d.photo || '') === (slot.dataset.photo || '')) slot.classList.add('photo-ready');
              });
            })();
          </script>
          <div class="ctas">
            <a class="btn btn-primary" href={base + 'work/'}><Text k="home.ctaWork" /> <Icon name="arrow" /></a>
            <a class="btn btn-ghost" href={base + 'contact/'}><Text k="home.ctaHire" /></a>
          </div>
        </div>

        <div class="side right" data-intro="right">
          <blockquote class="quote">
            <span class="qmark" aria-hidden="true">“</span>
            <Text as="p" class="muted" k="home.quote" />
          </blockquote>
          <ul class="skills" aria-label="What I do">
            {skills.map((s) => <li class:list={['skill', { on: s.on }]}>{s.label}</li>)}
          </ul>
        </div>
      </div>

      <a class="available" href={base + 'contact/'}>
        <span class="arrow-badge"><Icon name="arrow-up-right" size={18} /></span>
        <Text k="home.available" />
      </a>
    </div>
  </section>

  {/* Services */}
  <section class="section" id="services">
    <div class="container">
      <div class="section-head reveal">
        <div>
          <Text as="p" class="eyebrow" k="home.services.label" />
          <Text as="h2" k="home.services.title" />
        </div>
        <a class="pill-link" href={base + 'services/'}><Text k="home.services.more" /><span class="pill-arrow"><Icon name="arrow" size={18} /></span></a>
      </div>
      <div class="svc-list">
        {
          site.services.map((s, i) => (
            <details class="svc reveal" name="services" open={i === 0}>
              <summary>
                <span class="svc-n">{String(i + 1).padStart(2, '0')}.</span>
                <Text class="svc-title" k={`service.${i + 1}.title`} />
                <span class="arrow-badge" aria-hidden="true"><Icon name="arrow-up-right" size={16} /></span>
              </summary>
              <div class="svc-body">
                <ul class="svc-tags">{s.points.map((pt) => <li>{pt}</li>)}</ul>
                <Text as="p" k={`service.${i + 1}.text`} />
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  {/* About */}
  <section class="section about">
    <div class="container about-grid">
      <div class="about-card reveal" aria-hidden={aboutPhoto ? undefined : 'true'}>
        <div class:list={['about-photo placed', { 'has-photo': aboutPhoto }]} data-photo-slot="about" data-photo={aboutPhoto} data-fallback={leaf} style={aboutPos}>
          <img {...(aboutPhoto ? imgAttrs(aboutImg) : { src: leaf })} alt={aboutPhoto ? photoAlt : ''} width="460" height="518" loading="lazy" decoding="async" />
        </div>
        {chips.map((c, i) => <span class:list={['float-chip', i % 2 ? 'two' : 'one']} data-intro="chip">{c}</span>)}
      </div>
      <div class="about-text reveal">
        <Text as="p" class="eyebrow" k="home.about.label" />
        <Text as="h2" k="home.about.title" />
        <Text as="p" class="lead" k="home.about.text" />
        <div class="stats">
          {
            site.about.stats.map((_, i) => (
              <div class="stat">
                <span class="stat-v"><Text k={`stat.${i + 1}.value`} />+</span>
                <Text class="muted" k={`stat.${i + 1}.label`} />
              </div>
            ))
          }
        </div>
        <div class="about-actions">
          <a class="btn btn-primary" href={base + 'about/'}><Text k="home.about.more" /> <Icon name="arrow" /></a>
          <a class="btn btn-ghost" href={base + 'contact/'}><Text k="home.about.contact" /></a>
        </div>
      </div>
    </div>
  </section>

  {/* Selected work */}
  <section class="section">
    <div class="container">
      <div class="section-head reveal">
        <div>
          <Text as="p" class="eyebrow" k="home.work.label" />
          <Text as="h2" k="home.work.title" />
        </div>
        <a class="pill-link" href={base + 'work/'}><Text k="home.work.more" /><span class="pill-arrow"><Icon name="arrow" size={18} /></span></a>
      </div>
      <div class="grid grid-2" data-featured data-fp={fingerprint(featured)} set:html={featured.map((p, i) => cardHTML(p, i, base, covers)).join('')} />
    </div>
  </section>

  {/* Process */}
  <section class="section">
    <div class="container">
      <div class="section-head reveal">
        <div>
          <Text as="p" class="eyebrow" k="home.process.label" />
          <Text as="h2" k="home.process.title" />
        </div>
      </div>
      <ol class="grid grid-4 steps">
        {
          site.process.map((_, i) => (
            <li class:list={['step reveal', { on: i === 0 }]} style={`transition-delay:${i * 80}ms`}>
              <span class="num">{String(i + 1).padStart(2, '0')}</span>
              <Text as="h3" k={`process.${i + 1}.title`} />
              <Text as="p" k={`process.${i + 1}.text`} />
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  {
    site.testimonials.length > 0 && (
      <section class="section">
        <div class="container grid grid-3">
          {site.testimonials.map((t) => (
            <figure class="card reveal">
              <blockquote>“{t.quote}”</blockquote>
              <figcaption>
                <strong>{t.name}</strong>
                <span class="muted"> · {t.role}</span>
              </figcaption>
            </figure>
          ))}
        </div>
      </section>
    )
  }

  {/* CTA */}
  <section class="cta-band">
    <div class="container cta reveal">
      <Text as="h2" k="home.cta.title" />
      <Text as="p" k="home.cta.text" />
      <a class="btn cta-btn" href={base + 'contact/'}><Text k="home.cta.button" /> <span class="cta-arrow"><Icon name="arrow" size={18} /></span></a>
    </div>
  </section>
</Base>

<script>
  import { liveFeatured } from '../scripts/live';
  import { heroPhoto, homeMotion } from '../scripts/motion';
  import { liveProfilePhoto } from '../scripts/profile';
  liveFeatured(document.querySelector<HTMLElement>('[data-featured]')!).catch(() => {});
  homeMotion();
  liveProfilePhoto()
    .catch(() => {})
    .finally(heroPhoto);
</script>

<style>
  /* ---- Hero ---- */
  .hero {
    position: relative;
    overflow: hidden;
    padding-top: clamp(40px, 6vw, 64px);
  }
  .hero-inner {
    position: relative;
    display: grid;
    justify-items: center;
    text-align: center;
  }
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 22px;
    padding: 6px 16px 6px 6px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--surface);
    font-size: 0.85rem;
    font-weight: 600;
  }
  .badge-dot {
    width: 24px;
    height: 24px;
    border-radius: 999px;
    background: var(--amber);
  }
  h1 {
    font-size: clamp(2.8rem, 7.4vw, 5.6rem);
    margin-bottom: 14px;
  }
  .sub {
    margin: 0;
    color: var(--text-muted);
    font-size: clamp(1rem, 1.4vw, 1.15rem);
    font-weight: 500;
  }
  .stage-row {
    display: grid;
    width: 100%;
    margin-top: 24px;
    align-items: end;
  }
  @media (min-width: 1000px) {
    .stage-row {
      grid-template-columns: 1fr minmax(420px, 540px) 1fr;
      gap: 24px;
    }
  }
  .stage {
    position: relative;
    display: grid;
    justify-items: center;
    align-items: end;
    min-height: clamp(440px, 62vw, 660px);
    padding-bottom: 28px;
  }
  .watermark {
    position: absolute;
    left: 50%;
    top: 22%;
    transform: translateX(-50%);
    font: 700 clamp(6rem, 20vw, 16.5rem) / 1 var(--font-display);
    letter-spacing: -0.04em;
    color: transparent;
    -webkit-text-stroke: 1.5px var(--border);
    pointer-events: none;
    user-select: none;
    white-space: nowrap;
  }
  /* A soft amber light behind the photo, with no hard edge, so the photo
     stands out from the page. */
  .glow {
    position: absolute;
    bottom: 4%;
    left: 50%;
    width: min(120%, 620px);
    aspect-ratio: 1;
    transform: translateX(-50%);
    border-radius: 999px;
    background: radial-gradient(
      closest-side,
      color-mix(in srgb, var(--amber) 55%, transparent),
      color-mix(in srgb, var(--amber) 22%, transparent) 55%,
      transparent
    );
    filter: blur(24px);
    pointer-events: none;
  }
  /* The photo stands straight in the glow, with no frame, like the cut-out
     portrait in the design. A photo with a transparent background looks
     best; without a photo the leaf stands there. */
  .arch {
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: min(100%, 500px);
    aspect-ratio: 4 / 5;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .arch img {
    width: 42%;
    height: auto;
    margin-top: 20%;
  }
  .arch.has-photo {
    align-items: flex-end;
  }
  /* The photo rises into place once it's confirmed as the current one. */
  @media (prefers-reduced-motion: no-preference) {
    .js .arch.photo-ready img {
      animation: photo-rise 0.9s cubic-bezier(0.2, 1.25, 0.35, 1) both;
    }
  }
  @keyframes photo-rise {
    from {
      opacity: 0;
      transform: translateY(60px) scale(0.94);
    }
  }
  /* Moves the photo on scroll (src/scripts/motion.ts). */
  .lift {
    display: flex;
    width: 100%;
    height: 100%;
    align-items: inherit;
    justify-content: center;
  }
  .arch.has-photo img {
    width: 100%;
    height: 100%;
    margin: 0;
    object-fit: contain;
    object-position: center bottom;
  }
  /* The photo fades into the page at the bottom, as in the design. */
  .stage::after {
    content: '';
    position: absolute;
    inset: auto -40px 0;
    height: 30%;
    background: linear-gradient(transparent, var(--bg));
    pointer-events: none;
  }
  .ctas {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }
  .ctas .btn-ghost {
    background: rgb(18 18 18 / 0.55);
    backdrop-filter: blur(8px);
  }
  :global([data-theme='light']) .ctas .btn-ghost {
    background: rgb(255 255 255 / 0.75);
  }
  .side {
    display: grid;
    gap: 28px;
    padding-bottom: 60px;
  }
  .side.left {
    justify-items: start;
    text-align: left;
  }
  .side.right {
    justify-items: end;
    text-align: right;
  }
  .follow p {
    margin: 0 0 12px;
    font-weight: 500;
  }
  .socials {
    display: flex;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .socials a {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--surface);
    transition:
      border-color 0.2s,
      color 0.2s;
  }
  .socials a:hover {
    border-color: var(--amber);
    color: var(--accent);
  }
  .proof p {
    margin: 0;
    font-size: 0.9rem;
  }
  .proof-title {
    font: 700 1.25rem var(--font-display) !important;
    color: var(--accent);
    margin-bottom: 4px !important;
  }
  .quote {
    margin: 0;
    max-width: 260px;
  }
  .qmark {
    display: block;
    font: 700 3.5rem/0.8 var(--font-display);
    color: var(--amber);
  }
  .quote p {
    margin: 6px 0 0;
  }
  .skills {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 8px;
    max-width: 260px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .skill {
    padding: 8px 16px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--surface);
    font-size: 0.85rem;
    font-weight: 600;
  }
  .skill.on {
    border-color: var(--amber);
    background: var(--amber);
    color: var(--ink);
  }
  .available {
    position: absolute;
    top: 30px;
    right: 0;
    display: grid;
    justify-items: center;
    gap: 10px;
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1.3;
    color: var(--text-muted);
    text-decoration: none;
  }
  .available .arrow-badge {
    width: 56px;
    height: 56px;
    box-shadow:
      0 0 0 14px var(--surface),
      0 0 0 15px var(--border);
  }
  .available:hover .arrow-badge {
    transform: rotate(45deg);
  }
  @media (max-width: 999px) {
    .stage-row {
      gap: 28px;
    }
    .stage {
      order: -1;
    }
    .side,
    .side.left,
    .side.right {
      justify-items: center;
      text-align: center;
      padding-bottom: 0;
    }
    .skills {
      justify-content: center;
      max-width: none;
    }
    .quote {
      max-width: 34ch;
    }
    .available {
      display: none;
    }
  }

  /* ---- Pill link ("View all") ---- */
  .pill-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    text-decoration: none;
    font-weight: 700;
    font-size: 0.9rem;
  }
  .pill-link > span:first-child {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 20px;
    border-radius: 999px;
    background: var(--amber);
    color: var(--ink);
  }
  .pill-arrow {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 999px;
    background: var(--text);
    color: var(--bg);
    transition: transform 0.25s var(--ease);
  }
  .pill-link:hover .pill-arrow {
    transform: translateX(3px);
  }

  /* ---- Services accordion ---- */
  .svc-list {
    display: grid;
    gap: 12px;
  }
  .svc {
    border-radius: 18px;
    border: 1px solid var(--border);
    background: var(--surface);
    transition:
      background-color 0.25s,
      border-color 0.25s;
  }
  .svc summary {
    display: grid;
    grid-template-columns: 56px 1fr auto;
    align-items: center;
    gap: 12px;
    min-height: 72px;
    padding: 14px 18px 14px 24px;
    cursor: pointer;
    list-style: none;
  }
  .svc summary::-webkit-details-marker {
    display: none;
  }
  @media (min-width: 900px) {
    .svc summary {
      grid-template-columns: 200px 1fr auto;
      padding-left: 32px;
    }
    .svc-body {
      padding-left: 232px !important;
    }
  }
  .svc-n {
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--text-muted);
  }
  .svc-title {
    font: 600 clamp(1.1rem, 2vw, 1.4rem) / 1.25 var(--font-display);
  }
  .svc summary:hover .svc-title {
    color: var(--accent);
  }
  .svc-body {
    padding: 0 24px 26px 92px;
  }
  .svc-body p {
    margin: 14px 0 0;
    max-width: 62ch;
  }
  .svc-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .svc-tags li {
    padding: 5px 14px;
    border-radius: 999px;
    border: 1px solid currentColor;
    font-size: 0.8rem;
    font-weight: 600;
  }
  /* The open service turns amber with dark text. */
  .svc[open] {
    background: var(--amber);
    border-color: var(--amber);
    color: var(--ink);
  }
  .svc[open] .svc-n,
  .svc[open] summary:hover .svc-title {
    color: var(--ink);
  }
  .svc[open] .arrow-badge {
    background: var(--ink);
    color: var(--white);
    transform: rotate(90deg);
  }
  @media (max-width: 600px) {
    .svc summary {
      grid-template-columns: 34px 1fr auto;
      padding-left: 18px;
    }
    .svc-body {
      padding: 0 18px 22px;
    }
  }

  /* ---- About ---- */
  .about-grid {
    display: grid;
    gap: 48px;
    align-items: center;
  }
  @media (min-width: 900px) {
    .about-grid {
      grid-template-columns: minmax(320px, 460px) 1fr;
      gap: 72px;
    }
  }
  .about-card {
    position: relative;
    aspect-ratio: 8 / 9;
    border-radius: var(--radius-lg);
    background: var(--amber);
    overflow: hidden;
  }
  /* The About photo fills the card, placed as set in the admin. Without a
     photo the leaf sits in the middle of the card. */
  .about-photo {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
  }
  .about-photo:not(.has-photo) img {
    width: 34%;
    height: auto;
  }
  .float-chip {
    position: absolute;
    padding: 8px 16px;
    border-radius: 999px;
    background: var(--ink);
    color: var(--white);
    font-size: 0.85rem;
    font-weight: 700;
  }
  .float-chip.one {
    left: 6%;
    top: 62%;
    transform: rotate(8deg);
  }
  .float-chip.two {
    right: 6%;
    top: 76%;
    transform: rotate(-8deg);
  }
  .about-text .lead {
    max-width: 62ch;
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    margin: 28px 0;
  }
  .stat {
    display: grid;
    gap: 2px;
    padding: 18px 20px;
    border-radius: 18px;
    border: 1px solid var(--border);
    background: var(--surface);
  }
  .stat .muted {
    font-size: 0.85rem;
  }
  .stat-v {
    font: 700 clamp(1.8rem, 3vw, 2.3rem) / 1.25 var(--font-display);
    color: var(--accent);
  }
  .about-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  @media (max-width: 520px) {
    .stats {
      gap: 8px;
    }
    .stat {
      padding: 14px 12px;
    }
    .stat .muted {
      font-size: 0.75rem;
    }
  }

  /* ---- Process ---- */
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .step {
    padding: 26px;
    border-radius: 22px;
    border: 1px solid var(--border);
    background: var(--surface);
  }
  .step p {
    margin: 0;
