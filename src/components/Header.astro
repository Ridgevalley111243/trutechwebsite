---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import Text from './Text.astro';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const path = Astro.url.pathname.replace(base, '/');
const links = [
  { href: '', key: 'nav.home' },
  { href: 'services/', key: 'nav.services' },
  { href: 'work/', key: 'nav.work' },
  { href: 'about/', key: 'nav.about' },
  { href: 'contact/', key: 'nav.contact' },
];
const current = (href: string) => (href ? path.startsWith('/' + href) : path === '/');
---
<header class="site-header" data-header>
  <div class="container">
    <div class="bar">
      <a href={base} class="home" aria-label="Trutech Business home">
        <Logo />
      </a>
      <nav aria-label="Main">
        <ul id="nav-links" data-nav>
          {
            links.map((l) => (
              <li>
                <a href={base + l.href} aria-current={current(l.href) ? 'page' : undefined}>
                  <Text k={l.key} />
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <div class="actions">
        <button class="icon-btn theme" type="button" aria-pressed="false" data-theme-toggle>
          <span class="to-light"><Icon name="sun" size={18} /></span>
          <span class="to-dark"><Icon name="moon" size={18} /></span>
          <span class="sr-only">Light mode</span>
        </button>
        <a class="btn btn-light talk" href={base + 'contact/'}><Text k="nav.cta" /></a>
        <button class="icon-btn menu" type="button" aria-expanded="false" aria-controls="nav-links" data-menu>
          <span class="open"><Icon name="menu" size={20} label="Open menu" /></span>
          <span class="shut"><Icon name="close" size={20} label="Close menu" /></span>
        </button>
      </div>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]')!;
  const button = header.querySelector<HTMLButtonElement>('[data-menu]')!;
  const setOpen = (open: boolean) => {
    header.classList.toggle('is-open', open);
    button.setAttribute('aria-expanded', String(open));
  };
  button.addEventListener('click', () => setOpen(!header.classList.contains('is-open')));
  header.querySelectorAll('[data-nav] a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (e) => e.key === 'Escape' && setOpen(false));

  // Theme toggle (dark by default). The theme is applied before paint by Base.astro.
  const root = document.documentElement;
  const toggle = header.querySelector<HTMLButtonElement>('[data-theme-toggle]')!;
  const syncToggle = () => toggle.setAttribute('aria-pressed', String(root.dataset.theme === 'light'));
  toggle.addEventListener('click', () => {
    const next = root.dataset.theme === 'light' ? 'dark' : 'light';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {}
    syncToggle();
  });
  syncToggle();

  const onScroll = () => header.classList.toggle('is-scrolled', window.scrollY > 8);
  // Checked on the next frame, so reading the scroll position doesn't force
  // a layout while the page is still being set up.
  requestAnimationFrame(onScroll);
  window.addEventListener('scroll', onScroll, { passive: true });
</script>

<style>
  /* Floating pill bar that stays at the top while scrolling. */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    padding-top: 16px;
  }
  .bar {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 64px;
    padding: 10px 10px 10px 14px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--header-bg);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    transition: box-shadow 0.25s;
  }
  .is-scrolled .bar {
    box-shadow: var(--shadow);
  }
  .home {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration: none;
  }
  ul {
    display: flex;
    align-items: center;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  ul a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 14px;
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    border-radius: 999px;
    transition: color 0.2s;
  }
  ul a:hover,
  ul a[aria-current='page'] {
    color: var(--accent);
  }
  .actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .icon-btn {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: inherit;
    cursor: pointer;
    transition:
      background-color 0.2s,
      color 0.2s;
  }
  .icon-btn:hover {
    color: var(--accent);
  }
  .theme .to-dark,
  :global([data-theme='light']) .theme .to-light {
    display: none;
  }
  :global([data-theme='light']) .theme .to-dark {
    display: inline;
  }
  :global([data-theme='light']) .talk {
    background: var(--ink);
    color: var(--white);
  }
  .talk {
    min-height: 44px;
    padding: 0 20px;
  }
  .menu {
    display: none;
    background: var(--amber);
    color: var(--ink);
  }
  .menu:hover {
    color: var(--ink);
    background: var(--amber-hover);
  }
  .menu .shut {
    display: none;
  }
  @media (max-width: 900px) {
    .menu {
      display: inline-grid;
    }
    .talk {
      display: none;
    }
    ul {
      display: none;
      position: absolute;
      top: calc(100% + 10px);
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 2px;
      padding: 10px;
      background: var(--menu-bg);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      box-shadow: var(--shadow-lg);
    }
    .is-open ul {
      display: flex;
    }
    .is-open .menu .open {
      display: none;
    }
    .is-open .menu .shut {
      display: inline;
    }
    ul a {
      min-height: 48px;
      padding: 0 16px;
      font-size: 1.05rem;
    }
    ul a[aria-current='page'] {
      background: var(--surface-2);
    }
  }
</style>
