---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { site } from '../site';
import soraFont from '@fontsource-variable/sora/files/sora-latin-wght-normal.woff2?url';
import manropeFont from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';
import { SUPABASE_ANON_KEY, SUPABASE_URL } from '../lib/content';
import '@fontsource-variable/sora/wght.css';
import '@fontsource-variable/manrope/wght.css';
import '../styles/global.css';
import '../styles/portfolio.css';

interface Props {
  title?: string;
  description?: string;
  /** Private pages (client deliveries) must never be indexed. */
  noindex?: boolean;
  bare?: boolean;
}
const { title, description = site.description, noindex = false, bare = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const fullTitle = title ? `${title} · ${site.brand}` : `${site.brand}: ${site.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(`${base}brand/og.png`, Astro.site);

---
<!doctype html>
<html lang="en" data-base={base}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex, nofollow, noarchive" /> : <link rel="canonical" href={canonical} />}
    {noindex && <meta name="referrer" content="no-referrer" />}
    <meta name="theme-color" content="#121212" />
    <link rel="icon" type="image/png" href={`${base}favicon.png`} />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
    <link rel="preload" href={soraFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={manropeFont} as="font" type="font/woff2" crossorigin />
    {
      !bare && (
        <>
          <link rel="preconnect" href={SUPABASE_URL} crossorigin />
          <script is:inline define:vars={{ url: SUPABASE_URL, key: SUPABASE_ANON_KEY }}>
            // Ask for the latest settings straight away, before the page's
            // scripts have loaded (fetchSettings in src/lib/content.ts uses it).
            window.__settings = fetch(url + '/rest/v1/site_settings?select=data&id=eq.1', {
              headers: { apikey: key, Authorization: 'Bearer ' + key },
            })
              .then(function (r) {
                return r.ok ? r.json() : null;
              })
              .catch(function () {
                return null;
              });
          </script>
        </>
      )
    }
    {
      !noindex && (
        <>
          <meta property="og:type" content="website" />
          <meta property="og:title" content={fullTitle} />
          <meta property="og:description" content={description} />
          <meta property="og:image" content={ogImage} />
          <meta property="og:url" content={canonical} />
          <meta name="twitter:card" content="summary_large_image" />
        </>
      )
    }
    <script is:inline>
      // Runs before the page paints, so there's no flash of the wrong theme.
      (function () {
        var root = document.documentElement;
        root.classList.add('js');
        var saved = null;
        try {
          saved = localStorage.getItem('theme');
        } catch (e) {}
        // The design is dark first; light only when the visitor picks it.
        root.dataset.theme = saved === 'light' ? 'light' : 'dark';
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    {!bare && <Header />}
    <main id="main">
      <slot />
    </main>
    {!bare && <Footer />}
    {
      !bare && (
        <script>
          import { liveTexts } from '../scripts/texts';
          liveTexts().catch(() => {});
        </script>
      )
    }
    <script>
      // Reveal sections as they scroll into view (CSS skips this under reduced motion).
      const items = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) =>
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                io.unobserve(e.target);
              }
            }),
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
        );
        items.forEach((el) => io.observe(el));
      } else {
        items.forEach((el) => el.classList.add('is-visible'));
      }
    </script>
    {
      !bare && (
        <script>
          // Hidden way into the admin: long-press (phones) or double-click
          // (computers) an empty part of any page.
          const base = document.documentElement.dataset.base ?? '/';
          const open = () => (location.href = base + 'admin/');
          const empty = (t: EventTarget | null) =>
            t instanceof Element &&
            !t.closest('a, button, input, textarea, select, label, summary, video, img, svg, [role="button"], [contenteditable]');
          document.addEventListener('dblclick', (e) => {
            if (empty(e.target) && !getSelection()?.toString().trim()) open();
          });
          let timer: number | undefined;
          let x = 0;
          let y = 0;
          const cancel = () => clearTimeout(timer);
          document.addEventListener(
            'touchstart',
            (e) => {
              cancel();
              if (e.touches.length !== 1 || !empty(e.target)) return;
              ({ clientX: x, clientY: y } = e.touches[0]);
              timer = window.setTimeout(open, 1200);
            },
            { passive: true },
          );
          document.addEventListener(
            'touchmove',
            (e) => {
              const t = e.touches[0];
              if (Math.hypot(t.clientX - x, t.clientY - y) > 12) cancel();
            },
            { passive: true },
          );
          ['touchend', 'touchcancel', 'scroll'].forEach((t) => document.addEventListener(t, cancel, { passive: true }));
        </script>
      )
    }
  </body>
</html>
